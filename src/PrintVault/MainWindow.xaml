<Window x:Class="PrintVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PrintVault.Core;assembly=PrintVault.Core"
        Title="{x:Static core:AppVersion.Version}" Width="1540" Height="940"
        MinWidth="1180" MinHeight="720" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontSize="14" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>

    <Border x:Name="Sidebar" Grid.Column="0" Background="#0D1727" Padding="14,16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <Grid Margin="4,0,0,14">
            <StackPanel x:Name="SidebarBrand">
              <TextBlock Text="PRINTVAULT" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
              <TextBlock Text="3MF LIBRARY" FontSize="10" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <Button x:Name="SidebarToggleButton" Content="‹" Width="34" Height="32" Padding="0" Margin="0" HorizontalAlignment="Right"
                    Click="SidebarToggle_Click" ToolTip="Collapse navigation"/>
          </Grid>
        </StackPanel>

        <TextBlock x:Name="SidebarFooter" DockPanel.Dock="Bottom" Text="Fast native Windows library manager&#x0a;Optimized for large 3MF collections"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="4,14,4,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Expander Header="LIBRARY" IsExpanded="True" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5">
              <StackPanel Margin="0,3,0,7">
                <Button Content="Dashboard" Click="Dashboard_Click"/>
                <Button Content="All Models / List View" Click="List_Click"/>
                <Button Content="Gallery" Click="Gallery_Click"/>
              </StackPanel>
            </Expander>

            <Expander Header="ORGANIZE" IsExpanded="True" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5">
              <StackPanel Margin="0,3,0,7">
                <Button Content="Categories" Click="Categories_Click"/>
                <Button Content="Favorites" Click="Favorites_Click"/>
                <Button Content="Duplicates" Click="Duplicates_Click"/>
                <Button Content="Library Health" Click="LibraryHealth_Click" ToolTip="Library health, duplicates, missing thumbnails, review items, learned rules and operation history."/>
                <Button Content="Tag Manager" Click="TagManager_Click"/>
                <Button Content="Collections" Click="Collections_Click"/>
              </StackPanel>
            </Expander>

            <Expander Header="INTELLIGENCE" IsExpanded="True" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5">
              <StackPanel Margin="0,3,0,7">
                <Button Content="Model Intelligence" Click="ModelIntelligence_Click" ToolTip="Explore unified identity, evidence and relationships for the library without changing files or classifications."/>
                <Button Content="Apply Learned Rules" Click="ApplyLearnedRules_Click" ToolTip="Apply only high-confidence rules learned from your manual category corrections."/>
                <Button Content="Smart Cleanup" Click="Cleanup_Click"/>
                <Button Content="Smart Category Review" Click="SmartCategoryReview_Click" ToolTip="Review likely misclassified Terrain/Props and related models using semantic evidence. Changes are metadata-only."/>
                <Button Content="Build Multilingual Metadata" Click="BuildMultilingualMetadata_Click" ToolTip="Detect Chinese/Japanese/Korean filenames and build offline translated titles without renaming files."/>
                <Button Content="Reconcile Categories" Click="ReconcileCategories_Click" ToolTip="Map legacy category names, retire empty legacy categories, and preserve manual overrides."/>
              </StackPanel>
            </Expander>

            <Expander Header="ENGINEERING / TEST LABS" IsExpanded="False" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5">
              <StackPanel Margin="0,3,0,7">
                <Button Content="Entity Semantic Regression" Click="EntitySemanticRegressionChallenge_Click" ToolTip="Permanent semantic regression gate for named entities, domains, categories, subtypes, aliases, and controlled fixtures."/>
                <Button Content="HueForge Adversarial Regression" Click="ModelIntelligenceHueForgeChallenge_Click" ToolTip="Permanent adversarial regression for HueForge size, printer context, variants, and identity safety."/>
                <Button Content="Relationship Identity Gate" Click="RelationshipPrecisionChallenge_Click" ToolTip="Measure selective identity-anchor candidate indexing and relationship precision across the full catalog."/>
                <Button Content="Semantic + Relationship Integration" Click="SemanticRelationshipIntegrationChallenge_Click" ToolTip="Primary 9.x integration gate combining independently specified semantic identity and relationship expectations."/>
                <Button Content="Full Library Intelligence Challenge" Click="FullLibraryIntelligenceChallenge_Click" ToolTip="Run the controlled 1,758-record full-library intelligence and performance validation. Production data and physical 3MF files are read-only."/>
                <Button Content="Semantic Coverage &amp; Confidence" Click="SemanticCoverageChallenge_Click" ToolTip="Audit entity coverage, confidence, semantic contradictions, and identity coverage opportunities across the full library without applying changes."/>
                <Button Content="Semantic Evidence Convergence" Click="SemanticEvidenceFusionChallenge_Click" ToolTip="Run the current semantic evidence convergence challenge using entity, translation, analyzer, lexical, and context evidence without writing classifications."/>
                <Button Content="WHOLE-LIBRARY ROOT-CAUSE PASS" Click="WholeLibraryRootCause_Click" ToolTip="Analyze every catalog record and classify the actual causes of conflicts/review without changing the library."/>
              </StackPanel>
            </Expander>

            <Expander Header="TOOLS" IsExpanded="True" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold">
              <StackPanel Margin="0,3,0,0">
                <Button Content="Statistics" Click="Stats_Click"/>
                <Button Content="Settings / Library" Click="Settings_Click"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Width="120" Content="Open Selected" Click="Open_Click" HorizontalContentAlignment="Center"/>
          <ComboBox x:Name="ScanModeSelector" Width="150" Height="36" Margin="0,0,8,0" SelectedIndex="1" Foreground="#0B1728" Background="#E8EDF3" BorderBrush="#6F8299" FontWeight="SemiBold" ToolTip="Quick: index changes only. Turbo: analyze new/changed files. Deep: re-analyze everything.">
            <ComboBox.Resources>
              <!-- The closed ComboBox uses the selected ComboBoxItem for its selection box.
                   Explicit control/selection brushes prevent Windows theme brushes from
                   producing white-on-light-gray text and make the icon readable too. -->
              <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#142238"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F7FB"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#E8EDF3"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#0B1728"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BFD4EA"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B1728"/>
            </ComboBox.Resources>
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Background" Value="{StaticResource Panel2}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Style.Triggers>
                  <!-- Selected text is deliberately dark because WPF can reuse the
                       selected item as the closed ComboBox selection box. -->
                  <Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#0B1728"/><Setter Property="Background" Value="#BFD4EA"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#0B1728"/><Setter Property="Background" Value="#E8EDF3"/></Trigger>
                </Style.Triggers>
              </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBoxItem Content="⚡ Quick Scan"/>
            <ComboBoxItem Content="🚀 Turbo Scan"/>
            <ComboBoxItem Content="🧠 Deep Scan"/>
          </ComboBox><Button Width="125" Content="Start Scan" Click="Scan_Click" HorizontalContentAlignment="Center"/><Button Width="145" Content="Rebuild Library" Click="RebuildLibrary_Click" HorizontalContentAlignment="Center" ToolTip="Re-index every 3MF and re-run the current intelligence rules. Custom categories are preserved."/><Button Width="170" Content="Reset &amp; Rebuild Library" Click="ResetAndRebuildLibrary_Click" HorizontalContentAlignment="Center" ToolTip="Back up and clear stored library records, then rebuild all intelligence from the physical 3MF files. Does not delete 3MF files."/>
          </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
          <StackPanel Width="320" Margin="0,0,10,0">
            <TextBlock Text="SEARCH YOUR 3MF LIBRARY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,4"/>
            <TextBox x:Name="Search" Height="42" Padding="12,4" VerticalContentAlignment="Center" FontSize="15" ToolTip="Search normally or use filters such as category:vehicles tag:hueforge method:fdm type:miniature special:keychain material:pla favorite:true duplicate:true missingthumb:true review:true" TextChanged="Search_TextChanged"/>
            <TextBlock Text="Advanced: category:  tag:  method:  type:  special:  material:  favorite:true  duplicate:true  missingthumb:true  review:true" FontSize="9" Foreground="{StaticResource Muted}" Margin="4,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Width="110" Margin="0,0,8,0"><TextBlock Text="PRINT METHOD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,4"/><ComboBox x:Name="PrintMethodFilter" Height="42" SelectionChanged="IntelligenceFilter_Changed" Foreground="#0B1728" Background="#E8EDF3"><ComboBoxItem Content="All Methods" IsSelected="True"/><ComboBoxItem Content="FDM"/><ComboBoxItem Content="Resin"/><ComboBoxItem Content="Both"/><ComboBoxItem Content="Unknown"/></ComboBox></StackPanel>
          <StackPanel Width="125" Margin="0,0,8,0"><TextBlock Text="SPECIAL TYPE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,4"/><ComboBox x:Name="SpecialFilter" Height="42" SelectionChanged="IntelligenceFilter_Changed" Foreground="#0B1728" Background="#E8EDF3"><ComboBoxItem Content="All Special Types" IsSelected="True"/><ComboBoxItem Content="HueForge"/><ComboBoxItem Content="Keychain"/><ComboBoxItem Content="Other"/></ComboBox></StackPanel>
          <StackPanel Width="155" Margin="0,0,8,0"><TextBlock Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,4"/><ComboBox x:Name="CategoryFilter" Height="42" SelectionChanged="BrowseFilter_Changed" Foreground="#0B1728" Background="#E8EDF3" ToolTip="Show only files in this category"/></StackPanel>
          <StackPanel Width="155" Margin="0,0,8,0"><TextBlock Text="TAG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="4,0,0,4"/><ComboBox x:Name="TagFilter" Height="42" SelectionChanged="BrowseFilter_Changed" Foreground="#0B1728" Background="#E8EDF3" ToolTip="Show only files with this tag"/></StackPanel>
          <Button Content="Clear Filters" Width="105" Height="42" VerticalAlignment="Bottom" Click="ClearFilters_Click" ToolTip="Clear search, category, tag, print method, special type, and favorites filters"/>
        </StackPanel>
      </StackPanel>
      <DockPanel Grid.Row="1" Margin="0,14">
        <TextBlock x:Name="Status" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Text="  Scan mode:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0"/><TextBlock x:Name="ScanModeStatus" Text="Turbo" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        <ProgressBar x:Name="Progress" Width="260" Height="10" Margin="18,0,8,0" Minimum="0" Maximum="100"/><TextBlock x:Name="ScanProgressText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center" MinWidth="250"/>
      </DockPanel>

      <!-- DASHBOARD -->
      <ScrollViewer x:Name="Dashboard" Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Library Dashboard" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,18"/>
          <UniformGrid Columns="4" Margin="0,0,0,18">
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="MODELS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatModels" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="8,0"><StackPanel><TextBlock Text="FAVORITES" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatFavorites" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="8,0"><StackPanel><TextBlock Text="DUPLICATE GROUPS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatDuplicates" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="8,0,0,0"><StackPanel><TextBlock Text="MISSING THUMBNAILS" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatMissing" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <StackPanel>
              <DockPanel><TextBlock Text="LIBRARY HEALTH" FontSize="18" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Open Health Center" Width="150" Click="LibraryHealth_Click" HorizontalContentAlignment="Center"/></DockPanel>
              <TextBlock Text="Use Health Center to review duplicates, missing thumbnails, legacy categories, learned corrections, collections and operation history before making changes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="Categories" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding CategoryStats}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="CategoryStat_Click" Tag="{Binding Name}" Padding="0" Margin="0,2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ToolTip="Show files in this category"><DockPanel><TextBlock Text="{Binding Name}" Width="180"/><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource Accent}"/><ProgressBar Value="{Binding Percent}" Maximum="100" Height="7" Margin="8,5,8,0" IsHitTestVisible="False"/></DockPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="Recently Added / Updated" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding RecentModels}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="10" Margin="0,4"><DockPanel><Border Width="58" Height="58" Background="#0A1321" CornerRadius="6"><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding PrintMethod}" Foreground="{StaticResource Accent}" Margin="8,0,0,0"/><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- LIST -->
      <ListView x:Name="Models" Grid.Row="2" Visibility="Collapsed" GridViewColumnHeader.Click="GridViewColumnHeader_Click" ItemsSource="{Binding ModelView}" SelectionMode="Extended" SelectionChanged="Models_SelectionChanged" MouseDoubleClick="Models_DoubleClick" PreviewMouseRightButtonDown="Models_RightDown" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
        <ListView.ContextMenu>
          <ContextMenu x:Name="ListMenu">
            <MenuItem Header="Open in Default App" Click="Open_Click"/><MenuItem Header="Open File Location" Click="Location_Click"/><MenuItem Header="Copy Path" Click="Copy_Click"/><Separator/>
            <MenuItem Header="Change Category" Click="Category_Click"/><MenuItem Header="Reapply Category Rules" Click="Reapply_Click"/><MenuItem Header="Rename" Click="Rename_Click"/><MenuItem Header="Delete to Recycle Bin" Click="Delete_Click"/><Separator/>
            <MenuItem Header="Deep Analyze" Click="DeepAnalyze_Click"/><MenuItem Header="Refresh Thumbnail" Click="RefreshThumbnail_Click"/><MenuItem Header="Find Similar Names" Click="Similar_Click"/><MenuItem Header="Toggle Favorite" Click="Favorite_Click"/><MenuItem Header="Move to Current Category" Click="MoveCategory_Click"/><MenuItem Header="Undo Last Move" Click="Undo_Click"/><MenuItem Header="Undo Last Consolidation" Click="UndoConsolidation_Click"/><MenuItem Header="Undo Last Category Reconciliation" Click="UndoCategoryReconciliation_Click"/><Separator/>
            <MenuItem Header="Edit Tags" Click="EditTags_Click"/><MenuItem Header="Properties / Inspector" Click="Properties_Click"/>
          </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View><GridView>
          <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="280"/><GridViewColumn Header="Category" DisplayMemberBinding="{Binding Category}" Width="160"/><GridViewColumn Header="Print Method" DisplayMemberBinding="{Binding PrintMethod}" Width="100"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding SemanticType}" Width="130"/>
          <GridViewColumn Header="Tags" DisplayMemberBinding="{Binding Tags}" Width="220"/><GridViewColumn Header="Score" DisplayMemberBinding="{Binding IntelligenceScore,StringFormat={}{0:P0}}" Width="80"/><GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeText}" Width="95"/><GridViewColumn Header="Modified" DisplayMemberBinding="{Binding ModifiedText}" Width="145"/><GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="500"/>
        </GridView></ListView.View>
      </ListView>

      <!-- GALLERY -->
      <Grid x:Name="GalleryHost" Grid.Row="2" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding GalleryItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="235" Height="240" Background="{StaticResource Panel}" Margin="7" Padding="10" CornerRadius="12" MouseLeftButtonDown="GallerySelect_Click">
              <Border.ContextMenu><ContextMenu>
                <MenuItem Header="Open in Default App" Click="GalleryOpen_Click"/><MenuItem Header="Open File Location" Click="GalleryLocation_Click"/><MenuItem Header="Copy Path" Click="GalleryCopy_Click"/><Separator/>
                <MenuItem Header="Change Category" Click="GalleryCategory_Click"/><MenuItem Header="Reapply Category Rules" Click="GalleryReapply_Click"/><MenuItem Header="Rename" Click="GalleryRename_Click"/><MenuItem Header="Delete to Recycle Bin" Click="GalleryDelete_Click"/><Separator/>
                <MenuItem Header="Deep Analyze" Click="GalleryDeepAnalyze_Click"/><MenuItem Header="Refresh Thumbnail" Click="GalleryRefreshThumbnail_Click"/><MenuItem Header="Find Similar Names" Click="GallerySimilar_Click"/><MenuItem Header="Toggle Favorite" Click="GalleryFavorite_Click"/><MenuItem Header="Move to Current Category" Click="GalleryMoveCategory_Click"/><MenuItem Header="Undo Last Move" Click="Undo_Click"/><MenuItem Header="Undo Last Consolidation" Click="UndoConsolidation_Click"/><MenuItem Header="Undo Last Category Reconciliation" Click="UndoCategoryReconciliation_Click"/><Separator/>
                <MenuItem Header="Edit Tags" Click="GalleryEditTags_Click"/><MenuItem Header="Properties / Inspector" Click="GalleryProperties_Click"/>
              </ContextMenu></Border.ContextMenu>
              <StackPanel>
                <Border Height="150" Background="#0A1321" CornerRadius="8">
                  <Grid><Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/><TextBlock Text="NO PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5F718A" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasThumbnail}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                </Border>
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxHeight="40" Margin="0,8,0,0" FontWeight="SemiBold"/>
                <DockPanel Margin="0,7"><TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Tags}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding IntelligenceScore,StringFormat={}{0:P0}}" Foreground="{StaticResource Accent}"/></DockPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,8"><Button Content="‹ Previous" Width="100" Click="PreviousPage_Click"/><TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0"/><Button Content="Next ›" Width="100" Click="NextPage_Click"/></DockPanel>
      </Grid>
    </Grid>

    <Border Grid.Column="2" Background="{StaticResource Panel}" Margin="0,18,18,18" Padding="18" CornerRadius="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="MODEL INSPECTOR" FontSize="16" FontWeight="Bold"/>
        <Border Height="210" Margin="0,16,0,12" Background="#0A1321" CornerRadius="10"><Grid><Image x:Name="InspectorImage" Stretch="Uniform"/><TextBlock x:Name="InspectorPlaceholder" Text="NO PREVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5F718A" FontWeight="Bold"/></Grid></Border>
        <TextBlock x:Name="InspectorName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="InspectorTranslated" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        <TextBlock x:Name="InspectorMeta" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/>
        <TextBlock x:Name="InspectorIntel" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
        <TextBlock Text="TAGS" Foreground="{StaticResource Muted}" FontWeight="Bold" Margin="0,14,0,4"/>
        <TextBlock x:Name="InspectorTags" Text="No tags" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <Button Content="Open in Default App" Click="Open_Click"/><Button Content="Open File Location" Click="Location_Click"/><Button Content="Translate / Normalize Name" Click="TranslateCurrent_Click"/><Button Content="Edit Tags" Click="EditTags_Click"/><Button Content="Properties" Click="Properties_Click"/>
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
</Window>
